{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "declaration": true,
    "jsx": "react",
    "module": "es6",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "pretty": true,
    "resolveJsonModule": true,
    "strict": true,
    "rootDir": "src",
  },
  "exclude": [
    "node_modules",
    "dist"
  ],
  "include": [
    "src"
  ],
}
